# copia este archivo como .env y completa los valores (el archivo .env no se sube a Git)
# se usan solo con el perfil app de docker compose (docker compose --profile app up --build)

# claves de la API (texto aleatorio de 32 caracteres o mas y distintas entre si)
JWT_KEY=
LINKS_KEY=

# clave del superadmin (admin@flow.local) con 10 caracteres o mas y al menos un numero
SUPERADMIN_PASSWORD=

# datos de ejemplo opcionales (dos negocios de Manizales con equipo y clientes y citas)
# con DEMO_DATA en true hace falta una clave para las cuentas de ejemplo (10 caracteres o mas y al menos un numero)
DEMO_DATA=false
DEMO_PASSWORD=
